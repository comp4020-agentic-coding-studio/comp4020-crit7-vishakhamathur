---
import { getProgress, listYears } from "../lib/db";
import "../styles.css";

const years = listYears();
const requested = Number(Astro.url.searchParams.get("year"));
const year = years.includes(requested) ? requested : years.includes(2024) ? 2024 : years[0];
const progress = getProgress(year);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Degree progress tracker</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Tracker</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <div class="masthead">
        <img src="/anu-crest.svg" alt="Australian National University crest" width="56" height="58" />
        <h1>Degree progress tracker</h1>
      </div>
      <p>
        Bachelor of Advanced Computing (Honours), AACOM — units completed per
        category, checked against Programs & Courses' published requirements
        for the catalogue year you select below. Completed courses are
        stored once and re-checked against whichever year you're viewing.
      </p>

      <form method="get" action="/">
        <label for="year-select">Catalogue year</label>
        <select id="year-select" name="year">
          {years.map((y) => (
            <option value={y} selected={y === year}>{y}</option>
          ))}
        </select>
        <button>View</button>
      </form>

      <section aria-label="progress by category">
        {progress.map((cat) => (
          <div class="category">
            <h2>{cat.category}</h2>
            <p>{cat.completedUnits} / {cat.requiredUnits} units</p>
            <progress value={cat.completedUnits} max={cat.requiredUnits} aria-label={`${cat.category} progress`}>
              {cat.completedUnits} of {cat.requiredUnits} units
            </progress>
            {cat.missingRequiredCourses.length > 0 && (
              <p class="missing">Missing: {cat.missingRequiredCourses.join(", ")}</p>
            )}
            {cat.courses.length > 0 && (
              <ul class="course-list">
                {cat.courses.map((course) => (
                  <li>
                    {course.courseCode} ({course.units}u)
                    <form method="post" action={`/api/completed-courses/${course.id}/delete`}>
                      <input type="hidden" name="year" value={year} />
                      <button type="submit">Remove</button>
                    </form>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </section>

      <h2>Add a completed course</h2>
      <form method="post" action="/api/completed-courses">
        <input type="hidden" name="year" value={year} />
        <label for="courseCode">Course code</label>
        <input id="courseCode" name="courseCode" required maxlength="12" placeholder="COMP4020" />
        <label for="units">Units</label>
        <input id="units" name="units" type="number" min="1" max="48" value="6" required />
        <label for="category">Category</label>
        <select id="category" name="category" required>
          {progress.map((cat) => <option value={cat.category}>{cat.category}</option>)}
        </select>
        <button>Add</button>
      </form>
    </main>
  </body>
</html>
