---
import { getProgress, listYears } from "../lib/db";
import { courseLabel } from "../lib/course-names";
import { categoryAnchor } from "../lib/slug";
import "../styles.css";

const years = listYears();
const requested = Number(Astro.url.searchParams.get("year"));
const year = years.includes(requested) ? requested : years.includes(2024) ? 2024 : years[0];
const progress = getProgress(year);
const uploadError = Astro.url.searchParams.get("error") === "upload";

// Not enforced (this prototype doesn't track individual course levels), just
// a reminder of the real composition behind Comp Elective's unit total.
const categoryNotes: Record<string, string> = {
  "Comp Elective": "7 courses: 1 must be 4000-level, 2 must be 3000- or 4000-level, the rest any level.",
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Degree progress tracker</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Tracker</a>
      <a href="/readme/">About</a>
    </nav>
    <header class="hero">
      <div class="hero-inner">
        <div class="masthead">
          <img src="/anu-crest.svg" alt="Australian National University crest" width="56" height="58" />
          <h1>DEGREE PROGRESS TRACKER</h1>
        </div>
      </div>
    </header>
    <main>
      <form method="get" action="/" class="year-form">
        <label for="year-select">Start year</label>
        <select id="year-select" name="year">
          {years.map((y) => (
            <option value={y} selected={y === year}>{y}</option>
          ))}
        </select>
        <button>View</button>
      </form>

      <section class="upload-panel" aria-label="import from transcript">
        <h2>Import from a transcript</h2>
        {uploadError && (
          <p role="alert" class="missing">
            Couldn't read that as a PDF — try again with your ANU Statement of
            Result.
          </p>
        )}
        <p>
          Upload your Statement of Result and review the courses it detects
          before anything is saved.
        </p>
        <form method="post" action="/upload-preview" enctype="multipart/form-data">
          <input type="hidden" name="year" value={year} />
          <label for="transcript">Statement of Result (PDF)</label>
          <input id="transcript" name="transcript" type="file" accept="application/pdf" required />
          <button>Preview detected courses</button>
        </form>
      </section>

      <section aria-label="progress by category">
        {progress.map((cat) => (
          <div class="category" id={categoryAnchor(cat.category)}>
            <h2>{cat.category}</h2>
            <p>{cat.completedUnits} / {cat.requiredUnits} units</p>
            {categoryNotes[cat.category] && <p class="category-note">{categoryNotes[cat.category]}</p>}
            <progress value={cat.completedUnits} max={cat.requiredUnits} aria-label={`${cat.category} progress`}>
              {cat.completedUnits} of {cat.requiredUnits} units
            </progress>
            {cat.missingRequiredCourses.length > 0 && (
              <p class="missing">
                Missing: {cat.missingRequiredCourses.map((code) => courseLabel(code)).join(", ")}
              </p>
            )}
            {cat.courses.length > 0 && (
              <ul class="course-list">
                {cat.courses.map((course) => (
                  <li>
                    {courseLabel(course.courseCode, course.courseName)} ({course.units}u)
                    <form method="post" action={`/api/completed-courses/${course.id}/delete`}>
                      <input type="hidden" name="year" value={year} />
                      <input type="hidden" name="category" value={cat.category} />
                      <button type="submit">Remove</button>
                    </form>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </section>

      <h2>Add a completed course</h2>
      <form method="post" action="/api/completed-courses">
        <input type="hidden" name="year" value={year} />
        <label for="courseCode">Course code</label>
        <input id="courseCode" name="courseCode" required maxlength="12" placeholder="COMP4020" />
        <label for="courseName">Course name</label>
        <input id="courseName" name="courseName" maxlength="120" placeholder="Human-Centred Technology" />
        <label for="units">Units</label>
        <input id="units" name="units" type="number" min="1" max="48" value="6" required />
        <label for="category">Category</label>
        <select id="category" name="category" required>
          {progress.map((cat) => <option value={cat.category}>{cat.category}</option>)}
        </select>
        <button>Add</button>
      </form>
    </main>
  </body>
</html>
